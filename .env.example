# Copy this file to `.env` (same folder as docker-compose.yml) and fill in
# real values. `.env` is gitignored and must never be committed - Docker
# Compose reads it automatically and substitutes these into docker-compose.yml.

# Password for the Postgres container - used by both the db and backend services.
POSTGRES_PASSWORD=change-me

# Signing key for JWTs. Use a long, random string (32+ characters) -
# anyone with this key can mint valid access tokens for any user.
JWT_KEY=change-me-to-a-long-random-string

# Optional: an email that always gets the Admin role on registration,
# regardless of signup order (the alternative is whoever registers first -
# see AuthService.Register). Leave blank/unset to keep that default.
ADMIN_BOOTSTRAP_EMAIL=
